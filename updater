#\!/usr/bin/env bash
set -euo pipefail

# This updater is intended for Kali Linux environments only.
cd "$(dirname "$0")"

if [ "$(uname -s)" \!= "Linux" ]; then
  echo "Error: this updater is for Kali Linux only."
  exit 1
fi

if \! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: not inside a git repository."
  exit 1
fi

branch=$(git rev-parse --abbrev-ref HEAD)
remote=${1:-origin}
message=${2:-"Update organisation"}

if [ "$branch" = "HEAD" ]; then
  echo "Error: detached HEAD. Switch to a branch before using this script."
  exit 1
fi

echo "OS detected: Linux"
echo "Repository root: $(pwd)"
echo "Current branch: $branch"
echo "Remote: $remote"
echo

echo "Choisissez une action :"
echo "1) recevoir mise a jour"
echo "2) push mise a jour"
read -r -p "Entrez 1 ou 2 : " choice

git_status() {
  echo
  echo "== Statut git =="
  git status --short
  echo
}

case "$choice" in
  1)
    git_status
    echo "Récupération des mises à jour depuis $remote/$branch..."
    git fetch "$remote"
    git pull --ff-only "$remote" "$branch"
    echo "Mise à jour reçue."
    ;;
  2)
    git_status
    echo "== Fichiers modifies =="
    if git diff --name-only | tee /dev/stderr | grep -q .; then
      :
    else
      echo "(Aucune modification détectée)"
    fi
    echo
    read -r -p "Stage all changes before commit? [y/N] " stage
    if [ "$stage" = "y" ] || [ "$stage" = "Y" ]; then
      git add .
    else
      echo "Skipping automatic staging. Commit will include only already-staged files."
    fi
    echo
    read -r -p "Commit current staged changes and push to $remote/$branch? [y/N] " confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      echo "Aborted. No changes were pushed."
      exit 0
    fi

    if git diff --cached --quiet; then
      echo "No staged changes to commit."
    else
      git commit -m "$message"
    fi

    git push --set-upstream "$remote" "$branch"
    echo "Mises à jour envoyées."
    ;;
  *)
    echo "Choix invalide : $choice. Utilisez 1 ou 2."
    exit 1
    ;;
esac
